{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-18",
  // a navigation to a missing page gets the nearest 404.html without running the worker. the site links each page
  // without a trailing slash, so /about answers from about/index.html and /about/ redirects to it
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": false,
  // off so an uploaded version doesn't stay public at its own workers.dev address after a rollback
  "preview_urls": false,
  // the site's one address. a custom domain makes its own dns record and certificate, and keeping it here means every
  // deploy keeps it
  "routes": [{ "pattern": "jasonyue.ca", "custom_domain": true }],
  // no id, since wrangler 4.45 and later creates the namespace on the first deploy
  "kv_namespaces": [{ "binding": "HOME" }],
  // the daily github fetch
  "triggers": { "crons": ["17 9 * * *"] },
}
