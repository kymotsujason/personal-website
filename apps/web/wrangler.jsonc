{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-18",
  // a navigation to a missing page gets the nearest 404.html without running the worker. the site links each page
  // without a trailing slash, so /about answers from about/index.html and /about/ redirects to it
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": false,
  "preview_urls": true,
  // no id, since wrangler 4.45 and later creates the namespace on the first deploy
  "kv_namespaces": [{ "binding": "HOME" }],
  // the daily github fetch
  "triggers": { "crons": ["17 9 * * *"] },
  // previews get their own namespace, seeded once from github-fixture.json, and no GITHUB_TOKEN. previews bind KV
  // only by id, so this one can't be left for wrangler to create
  "previews": {
    "kv_namespaces": [
      { "binding": "HOME", "id": "536be70a170044c1bc198737e3c543cc" },
    ],
  },
}
