{
  "name": "apps-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ../../tools/html-rules.mjs --dist dist && node ../../tools/privacy/check.mjs --dist dist",
    "preview": "astro preview",
    "astro": "astro",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run && node --test \"src/scene/**/*.test.js\"",
    "security": "semgrep scan --metrics=off --config ../../semgrep.yml --error .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && playwright test && pnpm security",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.10",
    "@playwright/test": "~1.63.0",
    "@shadcn/lint": "~0.1.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "astro-eslint-parser": "~3.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "~3.1.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "~1.0.1",
    "typescript": "^6.0.3",
    "vite": "~8.3.4",
    "vitest": "~5.0.5",
    "wrangler": "^4.135.0"
  }
}
