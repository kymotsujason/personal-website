---
import { ClientRouter } from "astro:transitions";
import headSource from "../lib/head.js?raw";
import { APPS } from "../data/apps.js";
import { latestProject } from "../lib/projects";
import FlatScreens from "../components/FlatScreens.astro";
import "../styles/site.css";
import "../styles/flat.css";
import "../styles/flat-scene.css";

type Kind =
  | "home"
  | "about"
  | "projects"
  | "project"
  | "blog"
  | "post"
  | "music"
  | "not-found";

interface Props {
  title: string;
  description: string;
  app?: string;
  // an article for a post or a project, and the not found page claims no address of its own
  type?: "website" | "article";
  notFound?: boolean;
  // which page this is, for the styles that belong to one page. the not found page is always "not-found"
  kind?: Kind;
  // a detail page's glass pill in the top bar, back to its list
  back?: { href: string; label: string };
  // the page draws its own h1, so the layout leaves out the large title
  ownTitle?: boolean;
}

const {
  title,
  description,
  app = "home",
  type = "website",
  notFound = false,
  kind = "home",
  back,
  ownTitle = false,
} = Astro.props;
const pageKind = notFound ? "not-found" : kind;
// a page can pass the slot conditionally, and Astro still reports the name, so the content decides
const toolbar = Astro.slots.has("toolbar")
  ? (await Astro.slots.render("toolbar")).trim()
  : "";
const isApp = app !== "home";
const documentTitle = title === "Jason Yue" ? title : `${title} | Jason Yue`;
const latest = await latestProject();
// the data sits in a script element, so no "<" may end it early
const siteData = JSON.stringify({
  apps: APPS,
  latestProject: latest,
}).replace(/</g, "\\u003c");
const buildId = import.meta.env.BUILD_ID;
const path = Astro.url.pathname.replace(/(.)\/+$/, "$1");
// the head script reads this, and the not found page is neither the home screen nor an app
const pageApp = notFound ? "not-found" : app;
const pageUrl = new URL(path, Astro.site).href;
const imageUrl = new URL("/og.jpg", Astro.site).href;
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="build-id" content={buildId} />
    <meta name="page-app" content={pageApp} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={pageUrl} />
        <meta property="og:url" content={pageUrl} />
      </>
    )}
    <meta property="og:site_name" content="Jason Yue" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A foldable phone held open, showing the home screen of Jason Yue's site"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Jason Yue"
      href="/blog/rss.xml"
    />
    <script is:inline set:html={headSource}></script>
    <ClientRouter />
    <script type="application/json" id="site-data" set:html={siteData}></script>
    <script>
      import {
        goHome,
        inFlight,
        navigate,
        onNavigate,
        recoverFromChunk,
        setScenePageFlat,
        syncPagePinned,
      } from "../layout/navigation.js";
      import { createCover } from "../flat/cover.js";
      import "../layout/depth.js";
      import "../layout/edgeSwipe.js";
      import "../layout/facts.js";
      import { music } from "../layout/player.js";
      import { remove, write } from "../lib/storage.js";
      import { applySky, skyVars } from "../lib/sky.js";
      import { daylight, hourNow } from "../scene/daylight.js";
      import { sunPlace } from "../scene/skyPath.js";

      const root = document.documentElement;
      const page = document.getElementById("page");

      // the bar's small title and the top edge show once the large title has scrolled up under the bar, and the bottom
      // edge shows while more of the page is below
      const showNav = () => {
        const nav = page?.querySelector(":scope > header");
        const body = page?.querySelector(":scope > .body");
        if (!(nav instanceof HTMLElement) || !(body instanceof HTMLElement)) {
          return;
        }
        const title = page?.querySelector(".large-title");
        // the title's top is measured against the body, since a title inside a positioned box (a story's hero) has
        // that box as its offset parent. the page can be scaled while it's pinned on the phone, so the rect's gap is
        // put back to the body's own pixels
        let under = 24;
        if (title instanceof HTMLElement) {
          const box = body.getBoundingClientRect();
          const scale = box.height / body.clientHeight || 1;
          const top =
            (title.getBoundingClientRect().top - box.top) / scale +
            body.scrollTop;
          under = top + title.offsetHeight / 2 - nav.offsetHeight;
        }
        nav.classList.toggle("scrolled", body.scrollTop > under);
        nav.classList.toggle(
          "more-below",
          body.scrollHeight - body.clientHeight - body.scrollTop > 8,
        );
      };
      page?.addEventListener("scroll", showNav, {
        capture: true,
        passive: true,
      });
      addEventListener("resize", showNav);
      showNav();
      document.addEventListener("astro:after-swap", showNav);

      // the 2d and 3d version links are full page loads (data-astro-reload), since the head script picks once per
      // load. the choice is saved here, before the load starts
      document.addEventListener("click", (event) => {
        const link =
          event.target instanceof Element
            ? event.target.closest("a[data-version]")
            : null;
        if (!(link instanceof HTMLAnchorElement)) {
          return;
        }
        // "0" is the 3d choice, which the head script keeps over its checks of the device, as ?3d does
        if (link.dataset.version === "2d") {
          write("local", "2d", "1");
          remove("local", "flatAuto");
        } else {
          write("local", "2d", "0");
          remove("local", "2dAuto");
          remove("local", "flatAuto");
        }
      });

      // the flat page from here on. the event tells the layout's own listeners, such as the player's placement, the
      // same way the head script's watchdog does, and a scene that already failed ignores it
      const failScene = (reason = "scene") => {
        root.classList.add("scene-failed");
        root.classList.remove(
          "has-3d",
          "has-flat-scene",
          "flat-ready",
          "page-first",
        );
        syncPagePinned();
        dispatchEvent(new CustomEvent("scene-failed", { detail: reason }));
      };

      // the sky from the visitor's clock with no weather, the same as the scene without it. it's drawn at load in every
      // mode, since the scene sets its own only once it has the weather, after its models load. it refreshes only in
      // the flat site, since each scene keeps its own going
      const setClockSky = () => {
        const hour = hourNow();
        const sun = sunPlace(hour, { sunrise: 7, sunset: 19 });
        const { day, warm } = daylight(hour);
        applySky(
          root,
          skyVars({
            day,
            warm,
            scene: "clear",
            intensity: "moderate",
            sun: [sun.x, sun.y],
            sunUp: sun.up,
            moon: null,
            moonUp: 0,
          }),
        );
      };
      setClockSky();
      setInterval(() => {
        if (
          !root.classList.contains("has-3d") &&
          !root.classList.contains("has-flat-scene")
        ) {
          setClockSky();
        }
      }, 60000);
      addEventListener("scene-failed", setClockSky);

      // the 2d scene gets 10 s of the page being visible to show its first frame. on a page load the head script's
      // watchdog covers that, and this one is for a 2d scene that takes over from 3d later in the load, after the head
      // script's watchdog was already satisfied by the 3d scene and out of reach from here
      const startFlatWatchdog = () => {
        let left = 10000;
        let since = 0;
        let timer: ReturnType<typeof setTimeout> | null = null;
        const run = () => {
          if (timer !== null || document.hidden) {
            return;
          }
          since = performance.now();
          timer = setTimeout(giveUp, left);
        };
        const pause = () => {
          if (timer === null) {
            return;
          }
          clearTimeout(timer);
          timer = null;
          left -= performance.now() - since;
        };
        const onVisibility = () => (document.hidden ? pause() : run());
        const giveUp = () => {
          timer = null;
          document.removeEventListener("visibilitychange", onVisibility);
          if (
            Reflect.get(window, "__flatShown") ||
            root.classList.contains("scene-failed")
          ) {
            return;
          }
          failScene("watchdog");
        };
        document.addEventListener("visibilitychange", onVisibility);
        run();
      };

      // the 2d scene's module, loaded once, by its start or by the fetch ahead at the 3d ladder's last step
      let flatModule: Promise<typeof import("../flat/index.js")> | null = null;
      const loadFlat = () => (flatModule ??= import("../flat/index.js"));

      type Host = {
        stageEl: HTMLElement;
        pageEl: HTMLElement;
        dataEl: HTMLElement;
      };

      // the 2d scene on the stage. from is "3d" for the handoff, which starts it from the page the address names
      const startFlat = (
        { startFlatScene }: typeof import("../flat/index.js"),
        { stageEl, pageEl, dataEl }: Host,
        {
          from = null,
          onShown = () => {},
        }: { from?: string | null; onShown?: () => void } = {},
      ) => {
        const flat = startFlatScene({
          stageEl,
          pageEl,
          siteData: JSON.parse(dataEl.textContent ?? "{}"),
          music,
          links: { navigate, goHome },
          onShown: () => {
            // the 2d scene covers the page now, so it is pinned on the phone unless it shows as the flat page
            root.classList.remove("page-first");
            syncPagePinned();
            onShown();
          },
          onFailed: (reason: unknown) =>
            failScene(typeof reason === "string" ? reason : undefined),
          onPageFlat: setScenePageFlat,
          arrival: Reflect.get(window, "__arrival"),
          from,
        });
        // the 2d watchdog gave up, or the navigation met a new build, so a 2d scene still running stops
        addEventListener("scene-failed", (event) =>
          flat.fail(
            event instanceof CustomEvent && event.detail
              ? event.detail
              : "watchdog",
          ),
        );
        return flat;
      };

      // the head script's floor for the 2d scene (inert, constructable stylesheets, and css sin()), and a device the 2d
      // scene itself found too slow in the last 30 days stays on the plain flat page
      const flatAllowed = () => {
        try {
          return (
            "inert" in HTMLElement.prototype &&
            "adoptedStyleSheets" in document &&
            CSS.supports("width: calc(sin(1rad) * 1px)") &&
            !root.classList.contains("flat-slow")
          );
        } catch {
          return false;
        }
      };

      // the 3d ladder's last step before the handoff fetches the 2d module and its first sets, so a handoff after it
      // waits less. nothing is decoded, and a failure here only logs
      const fetchFlatAhead = () => {
        if (!flatAllowed()) {
          return;
        }
        loadFlat().then(
          (module) =>
            module.prefetchFlatScene().catch((error: unknown) => {
              console.warn("the 2d scene's frames didn't load ahead", error);
            }),
          (error: unknown) => {
            // the handoff asks again
            flatModule = null;
            console.warn("the 2d scene didn't load ahead", error);
          },
        );
      };

      type Navigation = Parameters<
        ReturnType<
          (typeof import("../flat/index.js"))["startFlatScene"]
        >["navigation"]
      >[0];
      type Handler = (navigation: Navigation) => unknown;

      // the navigation handler while the 2d scene loads: each navigation waits here until the 2d scene's handler is
      // there and then goes to it. the swap waits for at most 4 s on it, as on any handler (layout/navigation.js)
      const createRelay = () => {
        let target: Handler | null = null;
        const waiting: (() => void)[] = [];
        const pass = (fn: Handler) => {
          target = fn;
          waiting.splice(0).forEach((go) => go());
        };
        return {
          handler: (navigation: Navigation) =>
            target
              ? target(navigation)
              : new Promise((resolve) =>
                  waiting.push(() => resolve(target?.(navigation))),
                ),
          ready: pass,
          drop: () => pass(() => undefined),
        };
      };

      // the 3d scene found the device too slow during the visit and has stopped, and the 2d scene takes over on this
      // page load under a black cover, so the plain flat page never shows in between. a browser below the 2d floor gets
      // the plain flat page, as before
      const handOff = (host: Host) => {
        if (!flatAllowed()) {
          failScene("too slow for 3d");
          return;
        }
        // 1. the cover at once, a fresh 2d watchdog, the relay, and what the 3d teardown left on the page
        const cover = createCover(host.stageEl);
        cover.up();
        addEventListener("scene-failed", () => cover.remove());
        startFlatWatchdog();
        const relay = createRelay();
        onNavigate(relay.handler);
        document.body.classList.remove("ready", "over-phone");
        Reflect.deleteProperty(window, "__sceneShown");
        ["--glass-fill", "--bar-fill", "--rim-angle"].forEach((name) =>
          root.style.removeProperty(name),
        );
        music.waitWhile(() => false);
        setScenePageFlat(false);
        // glass-simple stays, since a device found slow keeps the simpler glass
        root.classList.remove("has-3d", "page-pinned");
        root.classList.add("has-flat-scene");
        const stop = (error: unknown, what: string) => {
          console.warn(what, error);
          relay.drop();
          failScene();
        };
        // 2. a navigation that was already swapping #page lands first. 3. the 2d scene loads, starting from the
        // address's page, and the navigations held meanwhile go to it. 4. the cover fades on its first frame. a
        // missing chunk doesn't reload here, since that would take the page from the visitor
        Promise.resolve(inFlight())
          .then(() => loadFlat())
          .then(
            (module) => {
              if (root.classList.contains("scene-failed")) {
                relay.drop();
                return;
              }
              const flat = startFlat(module, host, {
                from: "3d",
                onShown: () => cover.lift(),
              });
              relay.ready(flat.navigation);
            },
            (error) => stop(error, "the 2d scene didn't load"),
          )
          .catch((error) => stop(error, "the 2d scene didn't start"));
      };

      const stageEl = document.getElementById("stage");
      const dataEl = document.getElementById("site-data");
      if (
        root.classList.contains("has-3d") &&
        !root.classList.contains("scene-failed") &&
        stageEl &&
        page &&
        dataEl
      ) {
        import("../scene/index.js")
          .then(
            ({ startScene, sceneNavigation }) => {
              if (root.classList.contains("scene-failed")) {
                return;
              }
              const scene = startScene({
                stageEl,
                pageEl: page,
                siteData: JSON.parse(dataEl.textContent ?? "{}"),
                onShown: () => {
                  Object.assign(window, { __sceneShown: true });
                  // the scene covers the page now, so it is pinned on the phone unless it shows as the flat page
                  root.classList.remove("page-first");
                  syncPagePinned();
                },
                onFailed: (reason: unknown) =>
                  reason === "handoff"
                    ? handOff({ stageEl, pageEl: page, dataEl })
                    : failScene(
                        typeof reason === "string" ? reason : undefined,
                      ),
                onLastStep: fetchFlatAhead,
                onPageFlat: setScenePageFlat,
                music,
              });
              onNavigate(sceneNavigation(scene, { navigate, goHome }));
              // the head script's watchdog gave up, or the navigation met a new build, so a scene still running stops
              addEventListener("scene-failed", (event) =>
                scene.fail(
                  event instanceof CustomEvent && event.detail
                    ? event.detail
                    : "watchdog",
                ),
              );
            },
            (error) => {
              console.warn("the scene didn't load", error);
              // a chunk a deploy removed is the likely cause, so the page loads again once. not when the page already
              // shows flat, when it shows first, or when the browser is offline, since a reload would take the page
              // the visitor is reading away from them
              const reading =
                root.classList.contains("scene-failed") ||
                root.classList.contains("page-first") ||
                !navigator.onLine;
              if (reading || !recoverFromChunk()) {
                failScene();
              }
            },
          )
          .catch((error) => {
            console.warn("the scene didn't start", error);
            failScene();
          });
      }

      if (
        root.classList.contains("has-flat-scene") &&
        !root.classList.contains("scene-failed") &&
        stageEl &&
        page &&
        dataEl
      ) {
        loadFlat()
          .then(
            (module) => {
              if (root.classList.contains("scene-failed")) {
                return;
              }
              const flat = startFlat(module, {
                stageEl,
                pageEl: page,
                dataEl,
              });
              onNavigate(flat.navigation);
            },
            (error) => {
              console.warn("the 2d scene didn't load", error);
              // a missing chunk loads the page again once, under the same rule as the 3d scene's
              const reading =
                root.classList.contains("scene-failed") ||
                root.classList.contains("page-first") ||
                !navigator.onLine;
              if (reading || !recoverFromChunk()) {
                failScene();
              }
            },
          )
          .catch((error) => {
            console.warn("the 2d scene didn't start", error);
            failScene();
          });
      }
    </script>
  </head>
  <body>
    <div id="stage">
      <div id="css-layer"></div>
      <main id="page" data-app={app} data-page={pageKind}>
        <div class="sky" aria-hidden="true">
          <div class="stars"></div>
          <div class="clouds"></div>
          <div class="dim"></div>
        </div>
        <slot name="backdrop" />
        {isApp && (
          <header>
            {back ? (
              <a class="pill glass back" href={back.href}>
                <span class="chev" aria-hidden="true" />
                {back.label}
              </a>
            ) : (
              <a
                class="pill glass home-link home-icon header-home"
                href="/"
                tabindex="-1"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 3.2 2.6 11.4l1.3 1.5L5 12v8.5h5.5v-6h3v6H19V12l1.1.9 1.3-1.5z"
                    fill="currentColor"
                  />
                </svg>
              </a>
            )}
            <span class="inline-title">{title}</span>
            {back ? (
              <a
                class="pill glass home-link home-icon"
                href="/"
                aria-label="Home"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 3.2 2.6 11.4l1.3 1.5L5 12v8.5h5.5v-6h3v6H19V12l1.1.9 1.3-1.5z"
                    fill="currentColor"
                  />
                </svg>
              </a>
            ) : (
              <span />
            )}
          </header>
        )}
        <div class="body">
          <div class="column">
            {isApp && !ownTitle && (
              <div class="title-row">
                <a
                  class="pill glass home-link home-icon"
                  href="/"
                  aria-label="Home"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M12 3.2 2.6 11.4l1.3 1.5L5 12v8.5h5.5v-6h3v6H19V12l1.1.9 1.3-1.5z"
                      fill="currentColor"
                    />
                  </svg>
                </a>
                <h1 class="large-title">{title}</h1>
              </div>
            )}
            <slot />
            <footer class="flat-footer">
              <a
                href={notFound ? "/" : path}
                data-version="2d"
                data-astro-reload
              >
                2D version
              </a>
              <a
                href={notFound ? "/" : path}
                data-version="3d"
                data-astro-reload
              >
                3D version
              </a>
            </footer>
          </div>
        </div>
        {isApp && (
          <>
            <div class="edge top" aria-hidden="true" />
            <div class="edge bottom" aria-hidden="true" />
          </>
        )}
        {toolbar && <div class="toolbar glass" set:html={toolbar} />}
        {back && <div class="edge-swipe" aria-hidden="true" />}
        {isApp && (
          <>
            <span class="home-hint" aria-hidden="true">
              Swipe up to go home
            </span>
            <a
              class="home-bar"
              href="/"
              draggable="false"
              aria-label="Go home"
            />
          </>
        )}
      </main>
      <canvas id="gl-layer"></canvas>
    </div>
    <div id="player-host" inert></div>
    <FlatScreens apps={APPS} latestProject={latest} />
  </body>
</html>
