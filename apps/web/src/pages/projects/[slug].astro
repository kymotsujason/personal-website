---
import { getCollection, render } from "astro:content";
import Site from "../../layouts/Site.astro";
import { formatDay } from "../../lib/format";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  date,
  summary,
  kicker,
  stats,
  links = [],
  source,
  hero,
  highlights,
  results,
  stack,
  status,
  license,
  builtOn,
} = project.data;
const sourceLabel = {
  public: "Public",
  private: "Private",
  unreleased: "Not public yet",
}[source];
const showLinks = links.length > 0 || source === "private";
---

<Site
  title={title}
  description={summary}
  app="Projects"
  kind="project"
  back={{ href: "/projects", label: "Projects" }}
  type="article"
  ownTitle
>
  <div class="hero story-hero">
    <picture>
      {hero.loop && (
        <source media="(prefers-reduced-motion: reduce)" srcset={hero.still} />
      )}
      <img
        class="pic"
        src={hero.loop ?? hero.still}
        data-still={hero.still}
        alt={hero.alt}
        style={hero.position ? `object-position: ${hero.position}` : undefined}
      />
    </picture>
    <div class="words">
      <p class="kicker">{kicker}</p>
      <h1 class="large-title">{title}</h1>
      <p class="sub">{summary}</p>
    </div>
  </div>
  {showLinks && (
    <div class="story-links">
      {links.map((link, i) => (
        <a
          class:list={["pill glass", { accent: i === 0 }]}
          href={link.url}
          rel="noopener"
        >
          {link.label}
        </a>
      ))}
      {source === "private" && <span class="private">Source is private</span>}
    </div>
  )}
  <div class="story-stats">
    {stats.map((stat) => (
      <div class="stat glass">
        <b>{stat.value}</b>
        <span>{stat.label}</span>
      </div>
    ))}
  </div>
  <article class="sheet">
    <Content />
    <section class="highlights">
      <h2>Highlights</h2>
      <ol>
        {highlights.map((item, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <b>{item.title}</b>
              <span>{item.text}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>
    {results && (
      <figure class="results">
        <img src={results.src} alt={results.alt} loading="lazy" />
        <figcaption>{results.caption}</figcaption>
      </figure>
    )}
    <section class="stack">
      <h2>Built with</h2>
      <ul>
        {stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    <section class="details">
      <h2>Details</h2>
      <dl>
        <dt>Started</dt>
        <dd>
          <time datetime={date}>{formatDay(date)}</time>
        </dd>
        <dt>Status</dt>
        <dd>{status}</dd>
        {license && <dt>License</dt>}
        {license && <dd>{license}</dd>}
        <dt>Source</dt>
        <dd>{sourceLabel}</dd>
        {builtOn && <dt>Built on</dt>}
        {builtOn && (
          <dd>
            <a href={builtOn.url} rel="noopener">
              {builtOn.name}
            </a>
          </dd>
        )}
      </dl>
    </section>
  </article>
</Site>
